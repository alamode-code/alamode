#: ../../source/anphondir/outputanphon.rst:2
msgid "ANPHON: Output files"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:9
msgid "``PREFIX``.bands"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:11
msgid ""
"Phonon dispersion along given :math:`k` paths in units of cm :sup:`-1`. "
"Created when ``MODE = phonons`` with **KPMODE** = 1."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:14
msgid "``PREFIX``.dos"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:16
msgid ""
"Phonon density of states (DOS). Atom projected phonon DOSs are also "
"printed when ``PDOS = 1``. Created when ``MODE = phonons`` with "
"**KPMODE** = 2."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:19
msgid "``PREFIX``.tdos"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:21
msgid ""
"Two-phonon density of states for all irreducible :math:`k` points. "
"Created when ``MODE = phonons`` with **KPMODE** = 2 and ``TDOS = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:24
msgid "``PREFIX``.thermo"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:26
msgid ""
"Constant volume heat capacity, vibrational entropy, internal energy, and "
"vibrational free energy. Created when ``MODE = phonons`` with **KPMODE** "
"= 2. When ``FE_BUBBLE = 1`` is set in the **&analysis** field, an "
"additional bubble correction term to the vibrational free energy is also "
"calculated."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:31
msgid "``PREFIX``.msd"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:33
msgid ""
"Mean-square-displacements of atoms. Created when ``MODE = phonons`` with "
"**KPMODE** = 2 and ``PRINTMSD = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:36
msgid "``PREFIX``.sps"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:38
msgid ""
"Total and mode-decomposed scattering phase space. Created when ``MODE = "
"phonons`` with **KPMODE** = 2 and ``SPS = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:41
msgid "``PREFIX``.pr"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:43
msgid ""
"Participation ratio of every phonon mode. Created when ``MODE = phonons``"
" and ``PRINTPR = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:46
msgid "``PREFIX``.apr"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:48
msgid ""
"Atomic participation ratio of every phonon mode. Created when ``MODE = "
"phonons`` and ``PRINTPR = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:51
msgid "``PREFIX``.phvel"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:53
msgid ""
"Phonon group velocity along given :math:`k` paths. Created when ``MODE = "
"phonons`` with **KPMODE** = 1 and ``PRINTVEL = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:56
msgid "``PREFIX``.phvel_all"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:58
#, python-brace-format
msgid ""
"Magnitude of group velocity :math:`|\\boldsymbol{v}|` of all phonon modes"
" at the uniform :math:`k` grid. Created when ``MODE = phonons`` with "
"**KPMODE** = 2 and ``PRINTVEL = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:61
msgid "``PREFIX``.evec, ``PREFIX``.band.evec, ``PREFIX``.mesh.evec"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:63
msgid ""
"Eigenvalues and eigenvectors of dynamical matrices. Eigenvalues are "
"printed in Rydberg atomic units. Created when ``MODE = phonons`` with "
"``PRINTEVEC = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:67
msgid "``PREFIX``.gruneisen"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:69
msgid ""
"Gr\\ |umulaut_u|\\ neisen parameters along given :math:`k` paths. Created"
" when ``MODE = phonons`` with **KPMODE** = 1 and ``GRUNEISEN = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:73
msgid "``PREFIX``.gru_all"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:75
msgid ""
"Gr\\ |umulaut_u|\\ neisen parameters of all phonon modes at the uniform "
":math:`k` grid. Created when ``MODE = phonons`` with **KPMODE** = 2 and "
"``GRUNEISEN = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:79
msgid "``PREFIX``.zmode"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:81
msgid ""
"Mode effective charges of zone-center phonon modes. Created when ``MODE ="
" phonons`` with ``ZMODE = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:84
msgid "``PREFIX``.axsf"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:86
msgid ""
"Zone-center phonon modes with directions indicated by arrows. This file "
"can be visualized by XcrySDen. Created when ``MODE = phonons`` with "
"``PRINTXSF = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:90
msgid "``PREFIX``.anime???.axsf and ``PREFIX``.anime???.xyz"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:92
msgid ""
"Files for animating phonon modes. ??? is the mode number. Created when "
"``MODE = phonons`` with a proper ``ANIME``-tag. If ``ANIME_FORMAT = "
"xsf``, axsf files will be created which can be displayed by XcrySDen. If "
"``ANIME_FORMAT = xyz``, xyz files will be created which can be visualized"
" by VMD, Jmol, etc."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:99
msgid "``PREFIX``.result"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:101
msgid ""
"In this file, phonon frequency, group velocity, and anharmonic phonon "
"linewidths are printed. This file is updated during thermal conductivity "
"calculations (``MODE = RTA``). In addition, this file is read when the "
"restart mode is turned on (``RESTART = 1``)."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:105
msgid "``PREFIX``.kl"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:107
msgid ""
"Lattice thermal conductivity tensor (Peierls term). Created when ``MODE ="
" RTA``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:109
msgid "``PREFIX``.kl_spec"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:111
msgid ""
"Spectra of lattice thermal conductivity. Only diagonal components are "
"saved. Created when ``MODE = RTA`` and ``KAPPA_SPEC = 1``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:115
msgid "``PREFIX``.kl_coherent"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:117
msgid ""
"Coherent component of lattice thermal conductivity. Created when "
"``KAPPA_COHERENT > 0`` in ``MODE = RTA``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:120
msgid "``PREFIX``.kc_elem"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:122
msgid ""
"Momentum- and mode-decomposed contributions to the coherent components of"
" lattice thermal conductivity. Created when ``KAPPA_COHERENT = 2`` in "
"``MODE = RTA``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:126
msgid "``PREFIX``.self_isotope"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:128
msgid ""
"Phonon selfenergy due to isotope scatterings calculated by Tamura's "
"formula. Created when ``MODE = RTA`` and ``ISOTOPE = 2``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:133
msgid "``PREFIX``.scph_dymat"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:135
msgid ""
"Anharmonic dynamical matrix calculated on the :math:`k` grid defined by "
"the ``KMESH_INTERPOLATE`` tag. This file is used to restart the SCPH "
"calculation."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:138
msgid "``PREFIX``.scph_bands"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:140
msgid "Anharmonic phonon dispersion curves."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:142
msgid "``PREFIX``.scph_dos"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:144
msgid ""
"Anharmonic phonon DOS. Created when ``MODE = SCPH`` and ``DOS = 1`` with "
"**KPMODE** = 2."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:147
msgid "``PREFIX``.scph_thermo"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:149
msgid ""
"Constant volume heat capacity, vibrational entropy, and vibrational free "
"energy calculated based on the self-consistent phonon calculation. "
"Created when ``MODE = SCPH`` with **KPMODE** = 2."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:155
msgid "``PREFIX``.scph_msd"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:157
msgid ""
"Mean square displacement calculated within the SCPH theory. Created when "
"``MODE = SCPH`` and ``PRINTMSD = 1`` with **KPMODE** = 2."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:159
msgid "``PREFIX``.scph_dfc2"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:161
msgid ""
"This file contains :math:`\\Delta D(\\boldsymbol{q}) = "
"D_{\\mathrm{SCPH}}(\\boldsymbol{q}) - "
"D_{\\mathrm{Harmonic}}(\\boldsymbol{q})`. For the definition, see the "
":ref:`formalism of the SCPH calculation <formalism_SCPH>`."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:166
msgid "``PREFIX``.atom_disp"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:168
#, python-brace-format
msgid ""
"Temperature-dependence of the atomic displacements "
":math:`u^{(0)}_{\\alpha \\mu}` in Cartesian representation. Created when "
"``MODE = SCPH`` and ``RELAX_STR != 0``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:170
msgid "``PREFIX``.normal_disp"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:172
#, python-brace-format
msgid ""
"Temperature-dependence of the atomic displacement "
":math:`q^{(0)}_{\\lambda}` in normal coordinate representation. Created "
"when ``MODE = SCPH`` and ``RELAX_STR != 0``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:174
msgid "``PREFIX``.umn_tensor"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:176
#, python-brace-format
msgid ""
"Temperature-dependence of the displacement gradient tensor :math:`u_{\\mu"
" \\nu}`. Created when ``MODE = SCPH`` and ``RELAX_STR = 2, -1, -2``."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:178
msgid "``PREFIX``.V0"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:180
msgid ""
"Temperature-dependent zero-th order IFC :math:`U_0`. Created when ``MODE "
"= SCPH`` and ``RELAX_STR != 0``. This file is used to restart the "
"SCPH/QHA + structural optimization."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:183
msgid "``PREFIX``.renorm_harm_dymat"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:185
msgid ""
"Renormalization of harmonic dynamical matrix by the structure change. "
"Created when ``MODE = SCPH`` and ``RELAX_STR != 0``. This file is used to"
" restart the SCPH/QHA + structural optimization."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:188
msgid "step_q0.txt"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:190
#, python-brace-format
msgid ""
"Record of atomic displacement :math:`q^{(0)}_{\\lambda}` at all steps of "
"structural optimization."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:192
msgid "step_u0.txt"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:194
#, python-brace-format
msgid ""
"Record of atomic displacements :math:`u^{(0)}_{\\alpha \\mu}` at all "
"steps of structural optimization."
msgstr ""

#: ../../source/anphondir/outputanphon.rst:196
msgid "step_u_tensor.txt"
msgstr ""

#: ../../source/anphondir/outputanphon.rst:198
#, python-brace-format
msgid ""
"Record of displacement gradient tensor :math:`u_{\\mu \\nu}` at all steps"
" of structural optimization."
msgstr ""

