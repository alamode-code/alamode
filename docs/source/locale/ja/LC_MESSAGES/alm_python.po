#: alm.alm.ALM:1 of
msgid ""
"Pythonic wrapper around the nanobind ALMCore object (legacy-compatible "
"API)."
msgstr ""

#: alm.alm.ALM.alm_new:1 of
msgid "Create the underlying C++ ALM instance."
msgstr ""

#: alm.alm.ALM.alm_new:3 of
msgid ""
"Called automatically by ``__init__``, so you normally never call this. It"
" is idempotent (a no-op if the instance already exists) and may be used "
"to recreate the instance after a manual :meth:`alm_delete`."
msgstr ""

#: alm.alm.ALM.alm_delete:1 of
msgid "Free the underlying C++ ALM instance immediately."
msgstr ""

#: alm.alm.ALM.alm_delete:3 of
msgid ""
"Optional: the instance is also freed automatically when this object is "
"garbage-collected.  Call this (or use a ``with`` block) only when you "
"want a prompt, deterministic release, e.g. inside a tight loop that "
"builds many large sensing matrices.  Idempotent."
msgstr ""

#: alm.alm.ALM.fix_force_constants_from_file:1 of
msgid ""
"Fix the `order`-th FCs (order=2 harmonic, 3 cubic, ...) to those in "
"`fc_file` (ALM .xml/.h5). Mirrors the CLI FC2FIX/FC3FIX tags. Call before"
" define()."
msgstr ""

#: alm.alm.ALM.set_supercell:1 of
msgid ""
"Define the base cell (given to the constructor) as the PRIMITIVE and map "
"it to the supercell. transmat_to_super: (3,3) integer matrix (a_s = M "
"a_p). Mirrors the CLI STRUCTURE_FILE(primitive)+SUPERCELL setup; call "
"after entering the context, before define()."
msgstr ""

#: alm.alm.ALM.set_constraint:1 of
msgid ""
"ICONST=11: algebraic translational invariance (acoustic sum rule). Sets "
"both the constraint mode and the algebraic flag (= ICONST//10), as the "
"CLI does; required for enet."
msgstr ""

#: alm.alm.ALM.set_forceconstants_to_fix:1 of
msgid "Fix a subset of FCs (e.g. FC2 from a reference fit)."
msgstr ""

#: alm.alm.ALM.freeze_fc:1 of
msgid "Legacy alias: freeze FCs to given values. fc_indices shape (n, order+1)."
msgstr ""

#: alm.alm.ALM.suggest:1 of
msgid "Compute the displacement patterns needed to determine the FCs."
msgstr ""

#: alm.alm.ALM.optimize:1 of
msgid ""
"Fit the FCs. solver: 'dense' (LAPACK SVD) or 'SimplicialLDLT' (Eigen "
"sparse)."
msgstr ""

#: alm.alm.ALM.get_matrix_elements:1 of
msgid ""
"Return (A, b): A shape (nrows, n_irred_fc) Fortran-order, b shape "
"(nrows,)."
msgstr ""

#: alm.alm.ALM.get_fc:1 of
msgid ""
"Return (values, elem_indices[n, fc_order+1]). mode: origin | irreducible "
