#: ../../source/alm_python.rst:395
msgid "ARD"
msgstr "ARD"

#: ../../source/alm_python.rst:396
msgid "per-coefficient Gaussian precision (evidence max.)"
msgstr "係数ごとのガウス精度 (エビデンス最大化)"

#: ../../source/alm_python.rst:397
msgid "yes (strong)"
msgstr "はい (強い)"

#: ../../source/alm_python.rst:398
